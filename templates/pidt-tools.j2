{#-
  Arms pidt-full / pidt-lean image: pi 1.3.0 + pi-dev-team (DEV_TEAM_REVIEW candidate)
  + ruff and lizard on PATH, so pi-dev-team's static-analysis pre-pass really runs
  (the SCB base image has neither: earlier runs logged "ruff not installed" and
  lizard never ran).
  Derived from templates/pidt-next.j2 (itself from SCB pi/docker.j2, upstream 31ceea3).
  pi is pinned here, NOT taken from {{ version }}: the agents' version
  ("1.3.0-pdt<sha7>-tools") is only the image cache key.
  If the pi-dev-team commit is not on GitHub yet, pre-build the image from a local
  checkout: scripts/build_pidt_local.sh agents/pidt-full.yaml (it reuses the
  tools block below between the "tools:" markers).
  Set the SHA with: scripts/set_pdt_sha.sh <sha>  (updates PDT_SHA below and the
  version of agents/pidt-full.yaml + agents/pidt-lean.yaml together).
-#}
{%- set PI_VERSION = "1.3.0" -%}
{%- set PDT_REPO = "https://github.com/sanjit-roopra/pi-dev-team" -%}
{%- set PDT_SHA = "3b80fff243a091126dc5c4db7e68c214090a7924" -%}
{%- set RUFF_VERSION = "0.17.1" -%}
{%- set LIZARD_VERSION = "1.24.1" -%}
FROM {{ base_image }}

# --- Root-level setup ---------------------------------------------------------
USER root

# jq: required by pi-dev-team hook scripts.
RUN apt-get update \
    && apt-get install -y --no-install-recommends jq \
    && rm -rf /var/lib/apt/lists/*

# --- tools:begin (static analysis for pi-dev-team; also used by scripts/build_pidt_local.sh)
# Isolated uv tool venvs under /opt/uv-tools, entry points in /usr/local/bin, which
# Debian's /etc/profile keeps on PATH for `bash -l`. Readable by any runtime uid;
# nothing is installed into the system or workspace Python.
RUN UV_TOOL_DIR=/opt/uv-tools UV_TOOL_BIN_DIR=/usr/local/bin UV_PYTHON_DOWNLOADS=never \
       uv tool install --no-cache --python /usr/local/bin/python3 ruff=={{ RUFF_VERSION }} \
    && UV_TOOL_DIR=/opt/uv-tools UV_TOOL_BIN_DIR=/usr/local/bin UV_PYTHON_DOWNLOADS=never \
       uv tool install --no-cache --python /usr/local/bin/python3 lizard=={{ LIZARD_VERSION }} \
    && chmod -R a+rX /opt/uv-tools \
    && test "$(ruff --version)" = "ruff {{ RUFF_VERSION }}" \
    && lizard --version | grep -qx "{{ LIZARD_VERSION }}"
# --- tools:end

# pi-dev-team, pinned by full SHA. World-writable: the container runs as the
# host uid, not as `agent`, and the extension writes state under its own dir.
RUN git clone -q {{ PDT_REPO }} /opt/pi-dev-team \
    && git -C /opt/pi-dev-team checkout -q {{ PDT_SHA }} \
    && test "$(git -C /opt/pi-dev-team rev-parse HEAD)" = "{{ PDT_SHA }}" \
    && chmod -R a+rwX /opt/pi-dev-team

# Git identity + defaults for the workflow's own commits (/plan, /build).
# System scope so it applies to whatever uid the container runs as.
RUN git config --system user.name "SCB Agent" \
    && git config --system user.email "agent@scb.local" \
    && git config --system init.defaultBranch main \
    && git config --system --add safe.directory '*'
ENV GIT_AUTHOR_NAME="SCB Agent" \
    GIT_AUTHOR_EMAIL="agent@scb.local" \
    GIT_COMMITTER_NAME="SCB Agent" \
    GIT_COMMITTER_EMAIL="agent@scb.local"

# --- Agent user ---------------------------------------------------------------
# SCB runs the agent through `bash -l`, and Debian's /etc/profile resets PATH,
# dropping the npm-global bin dir set via ENV below. Re-add it for login shells.
RUN printf 'export PATH="%s/.npm-global/bin:$PATH"\n' "$HOME" > /etc/profile.d/npm-global.sh

USER agent
WORKDIR /workspace

# Configure npm globals under user home
ENV NPM_CONFIG_PREFIX="$HOME/.npm-global"
ENV PATH="$HOME/.npm-global/bin:$PATH"
ENV XDG_CONFIG_HOME="$HOME/.config"
ENV XDG_DATA_HOME="$HOME/.local/share"

RUN npm install -g @earendil-works/pi-coding-agent@{{ PI_VERSION }} && \
    test "$("$NPM_CONFIG_PREFIX/bin/pi" --version)" = "{{ PI_VERSION }}" && \
    mkdir -p "$HOME/.pi/agent"

# --- Make the agent home usable by any runtime uid ---------------------------
# Containers run as the host user's uid:gid, not as `agent`, so relax modes
# on everything installed above.
RUN chmod -R a+rwX "$HOME"
