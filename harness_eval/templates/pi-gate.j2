{#-
  Arm pi-gate image: plain pi 1.3.0, no extension, plus ruff and lizard on PATH.
  Same as templates/pi-stock.j2 plus the tools block of templates/pidt-tools.j2,
  so pi-gate vs pi-stock isolates the static gate the prompt asks for, and
  pi-gate vs pidt-lean-fast isolates the rest of pi-dev-team.
-#}
{%- set PI_VERSION = "1.3.0" -%}
{%- set RUFF_VERSION = "0.17.1" -%}
{%- set LIZARD_VERSION = "1.24.1" -%}
FROM {{ base_image }}

# --- Root-level setup ---------------------------------------------------------
USER root

RUN apt-get update \
    && apt-get install -y --no-install-recommends jq \
    && rm -rf /var/lib/apt/lists/*

RUN git config --system user.name "SCB Agent" \
    && git config --system user.email "agent@scb.local" \
    && git config --system init.defaultBranch main \
    && git config --system --add safe.directory '*'
ENV GIT_AUTHOR_NAME="SCB Agent" \
    GIT_AUTHOR_EMAIL="agent@scb.local" \
    GIT_COMMITTER_NAME="SCB Agent" \
    GIT_COMMITTER_EMAIL="agent@scb.local"

# --- tools:begin (static analysis for pi-dev-team; also used by scripts/build_pidt_local.sh)
# Isolated uv tool venvs under /opt/uv-tools, entry points in /usr/local/bin, which
# Debian's /etc/profile keeps on PATH for `bash -l`. Readable by any runtime uid;
# nothing is installed into the system or workspace Python.
RUN UV_TOOL_DIR=/opt/uv-tools UV_TOOL_BIN_DIR=/usr/local/bin UV_PYTHON_DOWNLOADS=never \
       uv tool install --no-cache --python /usr/local/bin/python3 ruff=={{ RUFF_VERSION }} \
    && UV_TOOL_DIR=/opt/uv-tools UV_TOOL_BIN_DIR=/usr/local/bin UV_PYTHON_DOWNLOADS=never \
       uv tool install --no-cache --python /usr/local/bin/python3 lizard=={{ LIZARD_VERSION }} \
    && chmod -R a+rX /opt/uv-tools \
    && test "$(ruff --version)" = "ruff {{ RUFF_VERSION }}" \
    && lizard --version | grep -qx "{{ LIZARD_VERSION }}"
# --- tools:end

# --- Agent user ---------------------------------------------------------------
# SCB runs the agent through `bash -l`, and Debian's /etc/profile resets PATH,
# dropping the npm-global bin dir set via ENV below. Re-add it for login shells.
RUN printf 'export PATH="%s/.npm-global/bin:$PATH"\n' "$HOME" > /etc/profile.d/npm-global.sh

USER agent
WORKDIR /workspace

# Configure npm globals under user home
ENV NPM_CONFIG_PREFIX="$HOME/.npm-global"
ENV PATH="$HOME/.npm-global/bin:$PATH"
ENV XDG_CONFIG_HOME="$HOME/.config"
ENV XDG_DATA_HOME="$HOME/.local/share"

RUN npm install -g @earendil-works/pi-coding-agent@{{ PI_VERSION }} && \
    test "$("$NPM_CONFIG_PREFIX/bin/pi" --version)" = "{{ PI_VERSION }}" && \
    mkdir -p "$HOME/.pi/agent"

# --- Make the agent home usable by any runtime uid ---------------------------
RUN chmod -R a+rwX "$HOME"
