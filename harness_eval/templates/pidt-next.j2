{#-
  Arm pidt-next image: pi 1.3.0 + pi-dev-team @ 0958eac (candidate under test).
  If that commit is not on GitHub yet, pre-build the image from a local checkout: scripts/build_pidt_local.sh.
  Derived from SCB src/slop_code/agent_runner/agents/pi/docker.j2 (upstream 31ceea3).
  pi is pinned here, NOT taken from {{ version }}: agents/pidt-next.yaml's version
  ("1.3.0-pdt0958eac") is only the image cache key. Change PI_VERSION or
  PDT_SHA here -> change the version string in agents/pidt-next.yaml too.
-#}
{%- set PI_VERSION = "1.3.0" -%}
{%- set PDT_REPO = "https://github.com/sanjit-roopra/pi-dev-team" -%}
{%- set PDT_SHA = "0958eac198c8fc537e3cc43760e53cdfe157de68" -%}
FROM {{ base_image }}

# --- Root-level setup ---------------------------------------------------------
USER root

# jq: required by pi-dev-team hook scripts.
RUN apt-get update \
    && apt-get install -y --no-install-recommends jq \
    && rm -rf /var/lib/apt/lists/*

# pi-dev-team, pinned by full SHA. World-writable: the container runs as the
# host uid, not as `agent`, and the extension writes state under its own dir.
RUN git clone -q {{ PDT_REPO }} /opt/pi-dev-team \
    && git -C /opt/pi-dev-team checkout -q {{ PDT_SHA }} \
    && test "$(git -C /opt/pi-dev-team rev-parse HEAD)" = "{{ PDT_SHA }}" \
    && chmod -R a+rwX /opt/pi-dev-team

# Git identity + defaults for the workflow's own commits (/plan, /build).
# System scope so it applies to whatever uid the container runs as.
RUN git config --system user.name "SCB Agent" \
    && git config --system user.email "agent@scb.local" \
    && git config --system init.defaultBranch main \
    && git config --system --add safe.directory '*'
ENV GIT_AUTHOR_NAME="SCB Agent" \
    GIT_AUTHOR_EMAIL="agent@scb.local" \
    GIT_COMMITTER_NAME="SCB Agent" \
    GIT_COMMITTER_EMAIL="agent@scb.local"

# --- Agent user ---------------------------------------------------------------
# SCB runs the agent through `bash -l`, and Debian's /etc/profile resets PATH,
# dropping the npm-global bin dir set via ENV below. Re-add it for login shells.
RUN printf 'export PATH="%s/.npm-global/bin:$PATH"\n' "$HOME" > /etc/profile.d/npm-global.sh

USER agent
WORKDIR /workspace

# Configure npm globals under user home
ENV NPM_CONFIG_PREFIX="$HOME/.npm-global"
ENV PATH="$HOME/.npm-global/bin:$PATH"
ENV XDG_CONFIG_HOME="$HOME/.config"
ENV XDG_DATA_HOME="$HOME/.local/share"

RUN npm install -g @earendil-works/pi-coding-agent@{{ PI_VERSION }} && \
    test "$("$NPM_CONFIG_PREFIX/bin/pi" --version)" = "{{ PI_VERSION }}" && \
    mkdir -p "$HOME/.pi/agent"

# --- Make the agent home usable by any runtime uid ---------------------------
# Containers run as the host user's uid:gid, not as `agent`, so relax modes
# on everything installed above.
RUN chmod -R a+rwX "$HOME"
